# ─────────────────────────────────────────────────────────────
#  Школьная система наград — настройки
#  Скопируйте этот файл в .env и заполните значения.
#  Файл .env в git не попадает — пароли и токен остаются на сервере.
# ─────────────────────────────────────────────────────────────

# ── Адрес ────────────────────────────────────────────────────

# Публичный адрес сайта БЕЗ подпути.
# Локально:   http://localhost:8000
# На сервере: https://ваш-домен.ru
BASE_URL=http://localhost:8000

# Подпуть, если система живёт не в корне домена.
# Пусто  — сайт в корне (https://ваш-домен.ru/)
# /stars — сайт на подпути (https://ваш-домен.ru/stars/)
# ВАЖНО: nginx должен срезать этот префикс — см. deploy/nginx-host.conf
URL_PREFIX=

# ── Телеграм ─────────────────────────────────────────────────

# Токен бота от @BotFather (команда /newbot).
# Пока пусто — сервер работает, бот не запускается.
BOT_TOKEN=

# Имя бота БЕЗ символа @ (например: school_stars_bot).
# Нужно, чтобы собрать ссылку t.me/<имя>?start=<код> для QR-кодов.
BOT_USERNAME=

# Режим бота:
#   0 — long polling: работает везде, ничего настраивать не нужно
#   1 — webhook: Telegram сам шлёт обновления на наш адрес.
#       Быстрее, но BASE_URL обязан быть настоящим https-доменом.
USE_WEBHOOK=0

# ── Бот отметок преподавателей ───────────────────────────────

# Отдельный бот от @BotFather (не бот учеников!) — преподаватели отмечаются в нём
# геолокацией и кругляшком. Пусто — отметки в панели работают, бот не запускается.
# Тот же токен, что у бота учеников, не подойдёт: такой бот не запустится.
CHECKIN_BOT_TOKEN=

# Имя бота отметок БЕЗ @ — из него собираются ссылки-приглашения.
# Пусто — определится само при запуске бота.
CHECKIN_BOT_USERNAME=

# Часовой пояс школ: по нему считаются опоздания и «сегодня».
TZ_NAME=Asia/Tashkent

# ── Доступ ───────────────────────────────────────────────────

# Вход в панель: администратор и первый учитель.
# Эти значения читаются ОДИН раз — при первом запуске, когда в базе ещё нет
# пользователей. Потом пароли меняются в самой панели (кнопка «Пароль»),
# а администратор заводит остальных учителей на вкладке «Учителя».
# Забыли пароль администратора:
#   docker compose exec school-stars python scripts/reset_user_password.py admin
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
TEACHER_LOGIN=teacher
# На сервере (BASE_URL начинается с https) пустой TEACHER_PASSWORD НЕ ДОПУСКАЕТСЯ —
# сервер откажется стартовать. Пустой ADMIN_PASSWORD — администратор получит его же.
TEACHER_PASSWORD=

# Секрет для подписи сессий.
# Если не задать — сгенерируется и сохранится в data/jwt_secret.txt
JWT_SECRET=

# Отладочный вход в кабинет ученика БЕЗ Telegram (1 = включить).
# На сервере обязательно 0: иначе чужой человек откроет кабинет любого ребёнка.
DEV_LOGIN=0

# ── Прочее ───────────────────────────────────────────────────

# Название школы — печатается на карточках с QR-кодами
SCHOOL_NAME=Наша школа

# Где хранятся база, секрет сессий и загруженные фотографии.
# Пусто — каталог data/ рядом с проектом. В Docker задано в образе (/app/data).
DATA_DIR=
